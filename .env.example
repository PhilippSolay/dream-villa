# villa.solay.cloud — copy to .env and fill in. Never commit .env.
# Generate each secret/token with:  openssl rand -hex 32

SESSION_SECRET=replace-with-openssl-rand-hex-32
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
AGENT_TOKEN=replace-with-openssl-rand-hex-32

USER1_EMAIL=philipp@example.com
USER1_NAME=Philipp
USER1_PASSWORD=replace-with-a-long-passphrase
USER2_EMAIL=abigail@example.com
USER2_NAME=Abigail
USER2_PASSWORD=replace-with-a-long-passphrase

TZ=Asia/Makassar
SCRAPE_CRON=0 6 * * *
PLAYWRIGHT=0

# Contact address Nominatim asks for when geocoding pins.
NOMINATIM_EMAIL=you@example.com

# Optional: enables the LLM-assisted feedback parsing in `learn`. Leave empty to stay rule-based.
ANTHROPIC_API_KEY=

# Must match the existing Traefik setup on the VPS.
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt
